{
 "total": 24.8,
 "lines": [
  { "id": "xh1", "t0": 0.0, "t1": 3.0, "text": "徐晃，河东杨人，为郡吏，从杨奉。" },
  { "id": "xh2", "t0": 3.0, "t1": 5.8, "text": "说奉与天子还洛阳，遂归太祖。" },
  { "id": "xh3", "t0": 5.8, "t1": 9.4, "text": "从破颜良，拔白马，延津破文丑。" },
  { "id": "xh4", "t0": 9.4, "t1": 12.4, "text": "官渡之役，烧袁绍运车于故市。" },
  { "id": "xh5", "t0": 12.4, "t1": 15.2, "text": "潼关假道蒲阪，夜渡津，破马超。" },
  { "id": "xh6", "t0": 15.2, "t1": 18.2, "text": "樊城长驱径入，破羽十重围堑。" },
  { "id": "xh7", "t0": 18.2, "t1": 21.0, "text": "太祖曰：徐将军有周亚夫之风。" },
  { "id": "xh8", "t0": 21.0, "t1": 24.8, "text": "破上庸，进封阳平侯，薨，谥壮侯。" }
 ]
}
