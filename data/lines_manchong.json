{
  "film": "manchong",
  "voice": "zh-CN-YunjianNeural",
  "style": "ink",
  "total": 24.8,
  "lines": [
    { "id": "man1", "t0": 0.0, "t1": 3.0, "text": "山阳满宠，字伯宁，为许令，执法不挠。" },
    { "id": "man2", "t0": 3.0, "t1": 5.8, "text": "从太祖，迁汝南太守，募兵破敌，威行郡国。" },
    { "id": "man3", "t0": 5.8, "t1": 9.4, "text": "与张辽、李典共守合肥，拒孙权，城孤力战。" },
    { "id": "man4", "t0": 9.4, "t1": 12.4, "text": "论功迁奋威将军，封安昌亭侯。" },
    { "id": "man5", "t0": 12.4, "t1": 15.2, "text": "文帝即位，为征东将军，进封南乡侯。" },
    { "id": "man6", "t0": 15.2, "t1": 18.2, "text": "明帝时表筑合肥新城，徙屯据险，屡拒吴师。" },
    { "id": "man7", "t0": 18.2, "t1": 21.0, "text": "宠薨，谥曰景侯，宿将之风。" },
    { "id": "man8", "t0": 21.0, "t1": 24.8, "text": "执法峻刻，临敌有谋，魏之良将也。" }
  ]
}
