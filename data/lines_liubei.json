{
 "total": 24.8,
 "lines": [
  { "id": "lb1", "t0": 0.0, "t1": 3.0, "text": "刘备，涿郡人，少孤，贩履织席。" },
  { "id": "lb2", "t0": 3.0, "t1": 5.8, "text": "桃园结义，得关张为兄弟。" },
  { "id": "lb3", "t0": 5.8, "t1": 9.4, "text": "三顾茅庐，卧龙出山，隆中定策。" },
  { "id": "lb4", "t0": 9.4, "t1": 12.4, "text": "曹操南下，携民渡江，不忍弃之。" },
  { "id": "lb5", "t0": 12.4, "t1": 15.2, "text": "入蜀取益州，终成鼎足之势。" },
  { "id": "lb6", "t0": 15.2, "t1": 18.2, "text": "关羽既殁，举兵伐吴，夷陵一炬。" },
  { "id": "lb7", "t0": 18.2, "t1": 21.0, "text": "白帝托孤，付社稷于孔明。" },
  { "id": "lb8", "t0": 21.0, "t1": 24.8, "text": "仁德之君，惜以仁义失机。" }
 ]
}
