{
 "total": 24.8,
 "lines": [
  { "id": "ls1", "t0": 0.0, "t1": 3.0, "text": "陆逊，字伯言，吴郡吴人，江东大族。" },
  { "id": "ls2", "t0": 3.0, "t1": 5.8, "text": "为海昌屯田都尉，岁旱，开仓赈民。" },
  { "id": "ls3", "t0": 5.8, "t1": 9.4, "text": "吕蒙荐之代镇陆口，书与羽，羽意大安。" },
  { "id": "ls4", "t0": 9.4, "t1": 12.4, "text": "备率众伐吴，逊为大都督，相持七八月。" },
  { "id": "ls5", "t0": 12.4, "t1": 15.2, "text": "诸将请战，逊曰：吾已晓破之之术。" },
  { "id": "ls6", "t0": 15.2, "t1": 18.2, "text": "敕各持一把茅，以火攻拔之，破四十馀营。" },
  { "id": "ls7", "t0": 18.2, "t1": 21.0, "text": "备登马鞍山，四面蹙之，死者数万。" },
  { "id": "ls8", "t0": 21.0, "t1": 24.8, "text": "备仅入白帝城，惭恚曰：吾乃为逊所折辱。" }
 ]
}
