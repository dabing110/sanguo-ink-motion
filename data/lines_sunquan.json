{
 "total": 24.8,
 "lines": [
  { "id": "sq1", "t0": 0.0, "t1": 3.0, "text": "孙权，字仲谋，兄策遇刺，继领江东。" },
  { "id": "sq2", "t0": 3.0, "t1": 5.8, "text": "曹操南下，群臣欲降，权拔刀断案。" },
  { "id": "sq3", "t0": 5.8, "t1": 9.4, "text": "筑濡须坞，拒曹于江上。" },
  { "id": "sq4", "t0": 9.4, "t1": 12.4, "text": "合肥十万，为张辽所破。" },
  { "id": "sq5", "t0": 12.4, "t1": 15.2, "text": "武昌称帝，建号黄龙。" },
  { "id": "sq6", "t0": 15.2, "t1": 18.2, "text": "晚年二宫之争，骨肉相残。" },
  { "id": "sq7", "t0": 18.2, "t1": 21.0, "text": "猜忌杀戮，吴政日衰。" },
  { "id": "sq8", "t0": 21.0, "t1": 24.8, "text": "江东之主，前后五十二年。" }
 ]
}
