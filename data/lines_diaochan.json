{
 "total": 24.8,
 "lines": [
  { "id": "dc1", "t0": 0.0, "t1": 3.0, "text": "貂蝉，王允府中歌伎，色艺双绝。" },
  { "id": "dc2", "t0": 3.0, "t1": 5.8, "text": "允夜召之，跪告汉室倾危。" },
  { "id": "dc3", "t0": 5.8, "t1": 9.4, "text": "先许吕布，再献董卓，两相牵制。" },
  { "id": "dc4", "t0": 9.4, "t1": 12.4, "text": "一入郿坞，父子之隙已成。" },
  { "id": "dc5", "t0": 12.4, "t1": 15.2, "text": "凤仪亭畔，泣诉于温侯之前。" },
  { "id": "dc6", "t0": 15.2, "t1": 18.2, "text": "戟掷司徒，父子反目成仇。" },
  { "id": "dc7", "t0": 18.2, "t1": 21.0, "text": "郿坞火起，董卓伏诛阙下。" },
  { "id": "dc8", "t0": 21.0, "t1": 24.8, "text": "事成之后，芳踪杳然，不知所终。" }
 ]
}
