{
 "total": 24.8,
 "lines": [
  { "id": "cc1", "t0": 0.0, "t1": 3.0, "text": "曹操，沛国谯人，少机警，有权数。" },
  { "id": "cc2", "t0": 3.0, "t1": 5.8, "text": "为洛阳北部尉，五色棒不避豪强。" },
  { "id": "cc3", "t0": 5.8, "t1": 9.4, "text": "陈留起兵，奉天子以令不臣。" },
  { "id": "cc4", "t0": 9.4, "t1": 12.4, "text": "官渡焚乌巢之粮，一夕破袁绍。" },
  { "id": "cc5", "t0": 12.4, "t1": 15.2, "text": "赤壁连舟，东风火起，折戟北还。" },
  { "id": "cc6", "t0": 15.2, "t1": 18.2, "text": "潼关割须弃袍，几不免于马超。" },
  { "id": "cc7", "t0": 18.2, "t1": 21.0, "text": "进爵魏王，铜雀台成，遗令分香。" },
  { "id": "cc8", "t0": 21.0, "t1": 24.8, "text": "治世能臣，乱世奸雄，任人评说。" }
 ]
}
