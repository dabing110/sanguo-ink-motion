{
  "film": "zuoci",
  "voice": "winrt-kangkang",
  "style": "ink",
  "total": 35.0,
  "note": "史实边界：左慈确有其人（《后汉书·方术列传》），幻术情节出自《三国演义》第六十八回。八幕正传约35秒，回退自十二幕58秒扩片版。",
  "lines": [
    {
      "id": "u1_lujiang",
      "t0": 0.0,
      "t1": 3.8,
      "text": "庐江左慈，乌角先生。"
    },
    {
      "id": "u2_emei",
      "t0": 3.8,
      "t1": 7.6,
      "text": "天雷震壁，得遁甲天书。"
    },
    {
      "id": "u3_ganju",
      "t0": 7.6,
      "t1": 11.4,
      "text": "四十担柑橘，剖之皆空。"
    },
    {
      "id": "u4_ganju2",
      "t0": 11.4,
      "t1": 15.2,
      "text": "再剖有肉，笑而不辩。"
    },
    {
      "id": "u5_huan",
      "t0": 15.2,
      "t1": 20.6,
      "text": "画龙取肝，泼墨成牡丹。"
    },
    {
      "id": "u6_bei",
      "t0": 20.6,
      "t1": 24.4,
      "text": "掷杯化白鸠，绕殿而飞。"
    },
    {
      "id": "u7_yang",
      "t0": 24.4,
      "t1": 29.0,
      "text": "幻入羊群，分身千百。"
    },
    {
      "id": "u8_he",
      "t0": 29.0,
      "t1": 35.0,
      "text": "土鼠随金虎，奸雄一旦休。"
    }
  ]
}
