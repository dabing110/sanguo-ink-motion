{
 "total": 24.8,
 "lines": [
  { "id": "lm1", "t0": 0.0, "t1": 3.0, "text": "吕蒙，字子明，汝南富陂人，家贫。" },
  { "id": "lm2", "t0": 3.0, "t1": 5.8, "text": "年十五六窃随军，母怒将罚。" },
  { "id": "lm3", "t0": 5.8, "t1": 9.4, "text": "曰：不探虎穴，安得虎子。遂引刀杀吏。" },
  { "id": "lm4", "t0": 9.4, "t1": 12.4, "text": "为兵作绛衣行縢，权见之大悦。" },
  { "id": "lm5", "t0": 12.4, "t1": 15.2, "text": "从征黄祖，蒙勒前锋，亲枭就首。" },
  { "id": "lm6", "t0": 15.2, "t1": 18.2, "text": "士别三日，即更刮目相待。" },
  { "id": "lm7", "t0": 18.2, "t1": 21.0, "text": "伏兵舳舻中，使白衣摇橹作商贾人服。" },
  { "id": "lm8", "t0": 21.0, "t1": 24.8, "text": "取荆州，斩犯令者，军中震栗，道不拾遗。" }
 ]
}
