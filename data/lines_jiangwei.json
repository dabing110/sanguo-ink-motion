  "lines": [
    { "id": "j1_tianshui", "t0": 0.0,  "t1": 3.0,  "text": "姜维，天水冀人，好郑氏学。" },
    { "id": "j2_qishan",   "t0": 3.0,  "t1": 5.8,  "text": "祁山归亮，亮甚器之。" },
    { "id": "j3_beifa",    "t0": 5.8,  "t1": 9.2,  "text": "继志北伐，号为九伐中原。" },
    { "id": "j4_taoxi",    "t0": 9.2,  "t1": 12.2, "text": "洮西一役，大破王经。" },
    { "id": "j5_duangu",   "t0": 12.2, "t1": 15.0, "text": "段谷之败，星散流离。" },
    { "id": "j6_tazhong",  "t0": 15.0, "t1": 18.0, "text": "避黄皓，屯田沓中。" },
    { "id": "j7_jiange",   "t0": 18.0, "t1": 21.0, "text": "剑阁守险，会不能克。" },
    { "id": "j8_sanxian",  "t0": 21.0, "t1": 24.8, "text": "一计害三贤，胆大如斗。" }
  ]
}
