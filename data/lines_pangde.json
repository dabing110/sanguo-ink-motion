  "lines": [
    {
      "id": "p1_naan",
      "t0": 0.0,
      "t1": 3.0,
      "text": "庞德，南安狟道人。"
    },
    {
      "id": "p2_zhanyuan",
      "t0": 3.0,
      "t1": 5.8,
      "text": "为军锋，亲斩郭援。"
    },
    {
      "id": "p3_baima",
      "t0": 5.8,
      "t1": 9.2,
      "text": "常乘白马，射羽中额。"
    },
    {
      "id": "p4_gewei",
      "t0": 9.2,
      "t1": 12.2,
      "text": "随众降魏，拜立义将。"
    },
    {
      "id": "p5_dizhan",
      "t0": 12.2,
      "t1": 15.0,
      "text": "避水上堤，箭不虚发。"
    },
    {
      "id": "p6_beifu",
      "t0": 15.0,
      "t1": 18.0,
      "text": "水盛船覆，立而不跪。"
    },
    {
      "id": "p7_guogui",
      "t0": 18.0,
      "t1": 21.0,
      "text": "宁为国家鬼，不为贼将。"
    },
    {
      "id": "p8_zhuanghou",
      "t0": 21.0,
      "t1": 24.8,
      "text": "太祖流涕，谥曰壮侯。"
    }
  ]
}