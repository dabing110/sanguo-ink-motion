{
  "film": "guanlu",
  "voice": "winrt-kangkang",
  "style": "ink",
  "total": 30.4,
  "note": "史实边界：管辂事迹见《三国志·魏书·方技传》（与华佗同传）；桑下献脯、南斗添寿出自《三国演义》第六十九回。八幕约30秒。",
  "lines": [
    {
      "id": "g1_xingtong",
      "t0": 0.0,
      "t1": 4.0,
      "text": "平原管辂，少仰星辰。"
    },
    {
      "id": "g2_mingyi",
      "t0": 4.0,
      "t1": 7.6,
      "text": "明易通神，占相皆精。"
    },
    {
      "id": "g3_bushi",
      "t0": 7.6,
      "t1": 11.2,
      "text": "自卦三貍，其言果应。"
    },
    {
      "id": "g4_qingying",
      "t0": 11.2,
      "t1": 15.6,
      "text": "青蝇集鼻，位峻者颠。"
    },
    {
      "id": "g5_yusiren",
      "t0": 15.6,
      "t1": 19.0,
      "text": "与死人语，何所畏邪。"
    },
    {
      "id": "g6_dafeng",
      "t0": 19.0,
      "t1": 23.2,
      "text": "岁朝风起，晏飏皆诛。"
    },
    {
      "id": "g7_sangxia",
      "t0": 23.2,
      "t1": 26.8,
      "text": "桑下献脯，南斗添寿。"
    },
    {
      "id": "g8_shouzhi",
      "t0": 26.8,
      "t1": 30.4,
      "text": "寿止四八，天有常数。"
    }
  ]
}
