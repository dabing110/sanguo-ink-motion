{
  "film": "yuji",
  "voice": "winrt-kangkang",
  "style": "ink",
  "total": 30.4,
  "note": "史实边界：于吉符水治病、被孙策所斩，见《江表传》（裴注《三国志·孙策传》）；焚香伏拜、立坛祈雨、镜中索命出自《三国演义》第二十九回。八幕约30秒。",
  "lines": [
    {
      "id": "yj1_fushui",
      "t0": 0.0,
      "t1": 4.0,
      "text": "琅琊于吉，符水济世。"
    },
    {
      "id": "yj2_fenxiang",
      "t0": 4.0,
      "t1": 7.6,
      "text": "百姓焚香，伏道而拜。"
    },
    {
      "id": "yj3_jice",
      "t0": 7.6,
      "t1": 11.2,
      "text": "孙策忌之，以为惑众。"
    },
    {
      "id": "yj4_qiyu",
      "t0": 11.2,
      "t1": 15.6,
      "text": "立坛祈雨，云合雨倾。"
    },
    {
      "id": "yj5_yuzhu",
      "t0": 15.6,
      "t1": 19.0,
      "text": "雨霁策怒，竟斩于市。"
    },
    {
      "id": "yj6_jingzhong",
      "t0": 19.0,
      "t1": 23.2,
      "text": "策照镜中，见吉索命。"
    },
    {
      "id": "yj7_yicun",
      "t0": 23.2,
      "t1": 26.8,
      "text": "一存一亡，左慈骑鹤。"
    },
    {
      "id": "yj8_jiangdong",
      "t0": 26.8,
      "t1": 30.4,
      "text": "金疮迸裂，碧眼儿坐领江东。"
    }
  ]
}
