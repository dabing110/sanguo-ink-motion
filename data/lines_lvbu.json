{
 "total": 24.8,
 "lines": [
  { "id": "lvb1", "t0": 0.0, "t1": 3.0, "text": "五原吕布，弓马骁勇，号飞将。" },
  { "id": "lvb2", "t0": 3.0, "t1": 5.8, "text": "杀丁原而投董卓，人讥三姓。" },
  { "id": "lvb3", "t0": 5.8, "t1": 9.4, "text": "虎牢关前独战诸侯，人马辟易。" },
  { "id": "lvb4", "t0": 9.4, "t1": 12.4, "text": "王允连环，董卓终诛于郿坞。" },
  { "id": "lvb5", "t0": 12.4, "t1": 15.2, "text": "袭取徐州，反复无常，众皆疑之。" },
  { "id": "lvb6", "t0": 15.2, "t1": 18.2, "text": "辕门一箭，解袁刘两家之兵。" },
  { "id": "lvb7", "t0": 18.2, "t1": 21.0, "text": "白门楼上，缚见曹公，乞哀求生。" },
  { "id": "lvb8", "t0": 21.0, "t1": 24.8, "text": "缢死枭首，飞将终误于反复。" }
 ]
}
