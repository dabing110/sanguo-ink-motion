    {
      "id": "c1_zhongmu",
      "t0": 0.0,
      "t1": 3.0,
      "text": "中牟释曹，弃官相从。"
    },
    {
      "id": "c2_mingshi",
      "t0": 3.0,
      "t1": 5.8,
      "text": "说邈迎操，领兖州牧。"
    },
    {
      "id": "c3_puyang",
      "t0": 5.8,
      "t1": 9.2,
      "text": "叛操迎布，据濮阳火起。"
    },
    {
      "id": "c4_xiance",
      "t0": 9.2,
      "t1": 12.2,
      "text": "佐布画策，下邳相拒。"
    },
    {
      "id": "c5_guancheng",
      "t0": 12.2,
      "t1": 15.0,
      "text": "操决泗沂，水灌下邳。"
    },
    {
      "id": "c6_danzuo",
      "t0": 15.0,
      "t1": 18.0,
      "text": "白门楼上，但坐此人。"
    },
    {
      "id": "c7_buhuangu",
      "t0": 18.0,
      "t1": 21.0,
      "text": "请出就戮，引颈不还顾。"
    },
    {
      "id": "c8_shenhou",
      "t0": 21.0,
      "t1": 24.8,
      "text": "操养其母，嫁其女。"
    }
