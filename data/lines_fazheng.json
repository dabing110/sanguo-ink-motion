{
  "film": "fazheng",
  "voice": "zh-CN-YunjianNeural",
  "style": "ink",
  "total": 24.8,
  "lines": [
    { "id": "faz1", "t0": 0.0, "t1": 3.0, "text": "右扶风法正，字孝直，奇谋善断之士。" },
    { "id": "faz2", "t0": 3.0, "t1": 5.8, "text": "张松谋迎先主，正衔命涪水，迎奉车驾。" },
    { "id": "faz3", "t0": 5.8, "t1": 9.4, "text": "内外相济，遂定益州，赐爵关内侯。" },
    { "id": "faz4", "t0": 9.4, "t1": 12.4, "text": "定军献策，渊军大溃，斩夏侯渊于阵。" },
    { "id": "faz5", "t0": 12.4, "t1": 15.2, "text": "王汉中，以为尚书令、护军将军，恩荣备至。" },
    { "id": "faz6", "t0": 15.2, "t1": 18.2, "text": "先主东征败绩，武侯叹：孝直若在，能制主上。" },
    { "id": "faz7", "t0": 18.2, "t1": 21.0, "text": "章武元年卒，谥曰翼侯，追思其功。" },
    { "id": "faz8", "t0": 21.0, "t1": 24.8, "text": "谋主孝直，画奇计、定巴蜀，蜀汉之良规也。" }
  ]
}
