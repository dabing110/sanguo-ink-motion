  "lines": [
    { "id": "y1_juping",        "t0": 0.0,  "t1": 3.0,  "text": "于禁，泰山钜平人，起于行伍。" },
    { "id": "y2_luannengzheng", "t0": 3.0,  "t1": 5.8,  "text": "宛城之乱，在乱能整。" },
    { "id": "y3_raotun",        "t0": 5.8,  "t1": 9.2,  "text": "官渡焚屯三十余，斩获数千。" },
    { "id": "y4_buwang",        "t0": 9.2,  "t1": 12.2, "text": "昌豨虽旧友，法不可枉。" },
    { "id": "y5_qijun",         "t0": 12.2, "t1": 15.0, "text": "汉水泛溢，七军俱没。" },
    { "id": "y6_jiangling",     "t0": 15.0, "t1": 18.0, "text": "遂降，囚于江陵，系之于吴。" },
    { "id": "y7_beigui",        "t0": 18.0, "t1": 21.0, "text": "北归故国，须发皓白。" },
    { "id": "y8_lingwu",        "t0": 21.0, "t1": 24.8, "text": "陵屋见降服之画，惭恚而薨。" }
  ]
}
