  "lines": [
    { "id": "w1_jiwu",     "t0": 0.0,  "t1": 3.0,  "text": "典韦，己吾人，形貌魁梧。" },
    { "id": "w2_zhuhu",    "t0": 3.0,  "t1": 5.8,  "text": "逐虎过涧，为夏侯惇所见。" },
    { "id": "w3_zhangxia", "t0": 5.8,  "t1": 9.2,  "text": "帐下壮士有典君，提一双戟八十斤。" },
    { "id": "w4_puyang",   "t0": 9.2,  "t1": 12.2, "text": "濮阳先登，短戟所抵，应手而倒。" },
    { "id": "w5_wancheng", "t0": 12.2, "t1": 15.0, "text": "宛城夜变，双戟被盗。" },
    { "id": "w6_yuanmen",  "t0": 15.0, "t1": 18.0, "text": "独守辕门，贼不得入。" },
    { "id": "w7_dama",     "t0": 18.0, "t1": 21.0, "text": "创重发，瞋目大骂而死。" },
    { "id": "w8_kuiji",    "t0": 21.0, "t1": 24.8, "text": "太祖为流涕，亲自临哭，遣归葬襄邑。" }
  ]
}
