{
 "total": 24.8,
 "lines": [
  { "id": "zy1", "t0": 0.0, "t1": 3.0, "text": "周瑜，庐江人，与孙策同年，相友善。" },
  { "id": "zy2", "t0": 3.0, "t1": 5.8, "text": "佐孙策定江东，时年二十四。" },
  { "id": "zy3", "t0": 5.8, "t1": 9.4, "text": "赤壁之战，火攻破曹，天下震动。" },
  { "id": "zy4", "t0": 9.4, "t1": 12.4, "text": "攻南郡，中流矢，仍督战不休。" },
  { "id": "zy5", "t0": 12.4, "t1": 15.2, "text": "荆州之借，久争不决，心不能平。" },
  { "id": "zy6", "t0": 15.2, "t1": 18.2, "text": "既生瑜，何生亮，仰天长叹。" },
  { "id": "zy7", "t0": 18.2, "t1": 21.0, "text": "巴丘道中，病卒，年三十六。" },
  { "id": "zy8", "t0": 21.0, "t1": 24.8, "text": "儒将风流，曲有误，周郎顾。" }
 ]
}
