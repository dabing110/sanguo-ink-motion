  "total": 24.8,
  "lines": [
    {
      "id": "n1_fuping",
      "t0": 0.0,
      "t1": 3.0,
      "text": "祢衡，平原般人，少有才辩。"
    },
    {
      "id": "n2_kuangbing",
      "t0": 3.0,
      "t1": 5.8,
      "text": "称狂不往，傲视许都。"
    },
    {
      "id": "n3_gushi",
      "t0": 5.8,
      "t1": 9.2,
      "text": "操录鼓史，欲以贱辱之。"
    },
    {
      "id": "n4_yuyang",
      "t0": 9.2,
      "t1": 12.2,
      "text": "渔阳掺挝，声节殊妙。"
    },
    {
      "id": "n5_fanru",
      "t0": 12.2,
      "t1": 15.0,
      "text": "徐脱衣褐，颜色不怍。"
    },
    {
      "id": "n6_yingwu",
      "t0": 15.0,
      "t1": 18.0,
      "text": "揽笔作赋，文无加点。"
    },
    {
      "id": "n7_mazuo",
      "t0": 18.0,
      "t1": 21.0,
      "text": "出言不逊，骂座而死。"
    },
    {
      "id": "n8_yingwuzhou",
      "t0": 21.0,
      "t1": 24.8,
      "text": "葬于江渚，名鹦鹉洲。"
    }
  ]
}