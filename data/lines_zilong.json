  "lines": [
    {
      "id": "z1_changshan",
      "t0": 0.0,
      "t1": 3.2,
      "text": "赵云，字子龙，常山真定人。"
    },
    {
      "id": "z2_panhe",
      "t0": 3.2,
      "t1": 6.0,
      "text": "初从公孙瓒，磐河扬名。"
    },
    {
      "id": "z3_changban",
      "t0": 6.0,
      "t1": 9.8,
      "text": "长坂坡前，单骑救主。"
    },
    {
      "id": "z4_duodou",
      "t0": 9.8,
      "t1": 12.8,
      "text": "截江夺斗，忠勇双全。"
    },
    {
      "id": "z5_hanshui",
      "t0": 12.8,
      "t1": 15.8,
      "text": "汉水空营，疑兵退敌。"
    },
    {
      "id": "z6_jigu",
      "t0": 15.8,
      "t1": 18.8,
      "text": "箕谷断后，敛众而归。"
    },
    {
      "id": "z7_dan",
      "t0": 18.8,
      "t1": 21.6,
      "text": "先主叹曰：一身是胆。"
    },
    {
      "id": "z8_end",
      "t0": 21.6,
      "t1": 25.4,
      "text": "建兴七年卒，谥顺平侯。"
    }
  ]
}
