  "total": 24.8,
  "lines": [
    { "id": "weiy1", "t0": 0.0, "t1": 3.0, "text": "义阳魏延，以部曲从先主入蜀。" },
    { "id": "weiy2", "t0": 3.0, "t1": 5.8, "text": "数有战功，勇猛过人，善抚士卒。" },
    { "id": "weiy3", "t0": 5.8, "t1": 9.4, "text": "先主取汉中，拔延守汉中，北拒曹公。" },
    { "id": "weiy4", "t0": 9.4, "t1": 12.4, "text": "北伐每请兵万人，与亮异道会潼关。" },
    { "id": "weiy5", "t0": 12.4, "t1": 15.2, "text": "祁山鏖兵，勇冠三军，迁前军师。" },
    { "id": "weiy6", "t0": 15.2, "t1": 18.2, "text": "进征西大将军，假节，封南郑侯。" },
    { "id": "weiy7", "t0": 18.2, "t1": 21.0, "text": "武侯既没，延与杨仪争权，衅起。" },
    { "id": "weiy8", "t0": 21.0, "t1": 24.8, "text": "为马岱所斩，夷三族，文长惜哉。" }
  ]
}
