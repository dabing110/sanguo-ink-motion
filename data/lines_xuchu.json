{
  "film": "xuchu",
  "voice": "zh-CN-YunjianNeural",
  "style": "ink",
  "total": 24.8,
  "lines": [
    { "id": "xuch1", "t0": 0.0, "t1": 3.0, "text": "谯国许褚，长八尺腰十围，勇力绝人。" },
    { "id": "xuch2", "t0": 3.0, "t1": 5.8, "text": "汉末乱起，聚宗族数千家，坚壁御寇。" },
    { "id": "xuch3", "t0": 5.8, "t1": 9.4, "text": "率众归曹，太祖曰：此吾樊哙也。" },
    { "id": "xuch4", "t0": 9.4, "t1": 12.4, "text": "从征张绣、袁绍，身先士卒，数有战功。" },
    { "id": "xuch5", "t0": 12.4, "t1": 15.2, "text": "潼关之战，马超疑其有变，褚瞋目盼之。" },
    { "id": "xuch6", "t0": 15.2, "t1": 18.2, "text": "超不敢动。常侍太祖，出入不离左右。" },
    { "id": "xuch7", "t0": 18.2, "t1": 21.0, "text": "曹丕即位，迁武卫将军，赐爵关内侯。" },
    { "id": "xuch8", "t0": 21.0, "t1": 24.8, "text": "太和六年卒，谥曰壮侯，虎痴之名传。" }
  ]
}
