{
 "total": 24.8,
 "lines": [
  { "id": "zf1", "t0": 0.0, "t1": 3.0, "text": "张飞，涿郡屠户，勇冠三军。" },
  { "id": "zf2", "t0": 3.0, "t1": 5.8, "text": "桃园结义，与兄同生共死。" },
  { "id": "zf3", "t0": 5.8, "t1": 9.4, "text": "长坂桥头，横矛一喝，曹军辟易。" },
  { "id": "zf4", "t0": 9.4, "t1": 12.4, "text": "义释严颜，尽得巴郡之心。" },
  { "id": "zf5", "t0": 12.4, "t1": 15.2, "text": "宕渠山道，以少破张郃。" },
  { "id": "zf6", "t0": 15.2, "t1": 18.2, "text": "镇守巴西，魏人不敢来犯。" },
  { "id": "zf7", "t0": 18.2, "t1": 21.0, "text": "阆中帐下，鞭卒招祸，为部将所害。" },
  { "id": "zf8", "t0": 21.0, "t1": 24.8, "text": "万人之敌，惜暴而无恩。" }
 ]
}
