{
 "total": 24.8,
 "lines": [
  { "id": "sm1", "t0": 0.0, "t1": 3.0, "text": "司马懿，河内人，鹰视狼顾。" },
  { "id": "sm2", "t0": 3.0, "t1": 5.8, "text": "诸葛亮出祁山，懿据险不战。" },
  { "id": "sm3", "t0": 5.8, "t1": 9.4, "text": "亮遗巾帼以辱之，懿受而不怒。" },
  { "id": "sm4", "t0": 9.4, "t1": 12.4, "text": "五丈原对峙百日，终不出垒。" },
  { "id": "sm5", "t0": 12.4, "t1": 15.2, "text": "远征辽东，百日破公孙渊。" },
  { "id": "sm6", "t0": 15.2, "t1": 18.2, "text": "高平陵之变，一举夺曹爽之权。" },
  { "id": "sm7", "t0": 18.2, "t1": 21.0, "text": "父子相继专权，魏祚遂移。" },
  { "id": "sm8", "t0": 21.0, "t1": 24.8, "text": "晋室之基，实肇于此。" }
 ]
}
