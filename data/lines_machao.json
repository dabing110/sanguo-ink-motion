  "lines": [
    { "id": "m1_fufeng",   "t0": 0.0,  "t1": 3.0,  "text": "马超，字孟起，扶风茂陵人。" },
    { "id": "m2_tongguan", "t0": 3.0,  "t1": 5.8,  "text": "与韩遂举兵潼关。" },
    { "id": "m3_weinan",   "t0": 5.8,  "t1": 9.4,  "text": "渭南血战，曹公几不得脱。" },
    { "id": "m4_maoer",    "t0": 9.4,  "t1": 12.4, "text": "曹公叹：马儿不死，吾无葬地。" },
    { "id": "m5_lixian",   "t0": 12.4, "t1": 15.2, "text": "离间计破，孤骑西走。" },
    { "id": "m6_chengdu",  "t0": 15.2, "t1": 18.2, "text": "归先主，兵至城下，刘璋即降。" },
    { "id": "m7_piaoji",   "t0": 18.2, "t1": 21.0, "text": "拜骠骑将军，领凉州牧。" },
    { "id": "m8_weihou",   "t0": 21.0, "t1": 24.8, "text": "门宗二百余口，尽为孟德所诛。", "end_cap": 23.9 }
  ]
}
