 "total": 24.8,
 "lines": [
  {
   "id": "t1_donglai",
   "t0": 0.0,
   "t1": 3.0,
   "text": "太史慈，东莱人，郡奏曹史。"
  },
  {
   "id": "t2_beihai",
   "t0": 3.0,
   "t1": 5.8,
   "text": "北海被围，突重围请兵于刘备。"
  },
  {
   "id": "t3_yuanbi",
   "t0": 5.8,
   "t1": 9.2,
   "text": "猿臂善射，弦不虚发。"
  },
  {
   "id": "t4_shenting",
   "t0": 9.2,
   "t1": 12.2,
   "text": "神亭酣战，与孙策互易其物。"
  },
  {
   "id": "t5_guisun",
   "t0": 12.2,
   "t1": 15.0,
   "text": "策执其手：当与卿共之。"
  },
  {
   "id": "t6_jianchang",
   "t0": 15.0,
   "t1": 18.0,
   "text": "拜建昌都尉，委以南方之事。"
  },
  {
   "id": "t7_linzhong",
   "t0": 18.0,
   "t1": 21.0,
   "text": "丈夫生世，当带三尺之剑。"
  },
  {
   "id": "t8_ziyi",
   "t0": 21.0,
   "t1": 24.8,
   "text": "年四十一而卒，权甚悼惜之。"
  }
 ]
}