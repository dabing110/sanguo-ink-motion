  "total": 30.4,
  "note": "史实边界：华佗事迹见《三国志·魏书·方技传》（与管辂同传）——游学徐土、晓养性之术、精方药、麻沸散刳腹、五禽戏、忤曹下狱而死，皆为正史；「刮骨疗毒」出自《三国演义》第七十五回，正史无华佗为关羽疗伤事；「青囊书付狱吏被焚」见本传，演义第七十八回据此演为「治风疾神医身死」。八幕约30秒。",
  "lines": [
    {
      "id": "ht1_peiguo",
      "t0": 0.0,
      "t1": 4.0,
      "text": "华佗，字元化，沛国谯人也。"
    },
    {
      "id": "ht2_yangsheng",
      "t0": 4.0,
      "t1": 7.6,
      "text": "晓养性之术，年且百岁。"
    },
    {
      "id": "ht3_fangyao",
      "t0": 7.6,
      "t1": 11.2,
      "text": "精于方药，处剂不过数种。"
    },
    {
      "id": "ht4_mafei",
      "t0": 11.2,
      "t1": 15.6,
      "text": "饮麻沸散，刳腹而湔洗。"
    },
    {
      "id": "ht5_wuqinxi",
      "t0": 15.6,
      "t1": 19.0,
      "text": "作五禽之戏，以当导引。"
    },
    {
      "id": "ht6_guagu",
      "t0": 19.0,
      "t1": 23.2,
      "text": "刮骨疗毒，血流盈盘。"
    },
    {
      "id": "ht7_toufeng",
      "t0": 23.2,
      "t1": 26.8,
      "text": "曹公苦头风，针鬲而差。"
    },
    {
      "id": "ht8_yuzhong",
      "t0": 26.8,
      "t1": 30.4,
      "text": "此可以活人，吏不敢受。",
      "end_cap": 29.6
    }
  ]
}
