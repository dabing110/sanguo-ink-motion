  "lines": [
    {
      "id": "x1_zifang",
      "t0": 0.0,
      "t1": 3.0,
      "text": "荀彧，字文若，颍川人。"
    },
    {
      "id": "x2_fengtian",
      "t0": 3.0,
      "t1": 5.8,
      "text": "迎天子都许，以令诸侯。"
    },
    {
      "id": "x3_chizhong",
      "t0": 5.8,
      "t1": 9.2,
      "text": "每征伐在外，常居中持重。"
    },
    {
      "id": "x4_yidu",
      "t0": 9.2,
      "t1": 12.2,
      "text": "官渡一书，谏止退兵。"
    },
    {
      "id": "x5_juxian",
      "t0": 12.2,
      "t1": 15.0,
      "text": "前后所举，皆命世大才。"
    },
    {
      "id": "x6_buyi",
      "t0": 15.0,
      "t1": 18.0,
      "text": "谏九锡之议，曰不宜如此。"
    },
    {
      "id": "x7_konghe",
      "t0": 18.0,
      "t1": 21.0,
      "text": "馈食空器，以忧而薨。"
    },
    {
      "id": "x8_sanrixiang",
      "t0": 21.0,
      "t1": 24.8,
      "text": "荀令留香，谥曰敬侯。"
    }
  ]
}