{
 "total": 24.8,
 "lines": [
  { "id": "gy1", "t0": 0.0, "t1": 3.0, "text": "关羽亡命奔涿，遇先主于乡里。" },
  { "id": "gy2", "t0": 3.0, "t1": 5.8, "text": "桃园结义，誓以生死相随。" },
  { "id": "gy3", "t0": 5.8, "t1": 9.4, "text": "白马坡前，单骑斩颜良于万众。" },
  { "id": "gy4", "t0": 9.4, "t1": 12.4, "text": "封金挂印，义不苟留。" },
  { "id": "gy5", "t0": 12.4, "t1": 15.2, "text": "千里独行，过关斩将，终归先主。" },
  { "id": "gy6", "t0": 15.2, "t1": 18.2, "text": "华容道上，念旧放曹，义释之。" },
  { "id": "gy7", "t0": 18.2, "t1": 21.0, "text": "水淹七军，威震华夏。" },
  { "id": "gy8", "t0": 21.0, "t1": 24.8, "text": "吕蒙袭后，败走麦城，父子俱殁。" }
 ]
}
