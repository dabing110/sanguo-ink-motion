{
 "total": 24.8,
 "lines": [
  { "id": "zz1", "t0": 0.0, "t1": 3.0, "text": "张昭，字子布，彭城人，少好学。" },
  { "id": "zz2", "t0": 3.0, "t1": 5.8, "text": "汉末乱，率士民南渡长江。" },
  { "id": "zz3", "t0": 5.8, "t1": 9.4, "text": "孙策创业，命为长史，委以文武。" },
  { "id": "zz4", "t0": 9.4, "t1": 12.4, "text": "策临亡以弟权托昭，身自扶权上马。" },
  { "id": "zz5", "t0": 12.4, "t1": 15.2, "text": "魏使入门不下车，昭叱之遽下车。" },
  { "id": "zz6", "t0": 15.2, "t1": 18.2, "text": "权按刀怒，昭涕泣，顾命之语故在耳。" },
  { "id": "zz7", "t0": 18.2, "t1": 21.0, "text": "昭称疾不朝，权塞其门，昭又内封之。" },
  { "id": "zz8", "t0": 21.0, "t1": 24.8, "text": "容貌矜严有威风，权曰不敢妄言，谥文侯。" }
 ]
}
