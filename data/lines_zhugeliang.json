{
 "total": 24.8,
 "lines": [
  { "id": "zg1", "t0": 0.0, "t1": 3.0, "text": "诸葛亮，琅琊人，躬耕陇亩。" },
  { "id": "zg2", "t0": 3.0, "t1": 5.8, "text": "三顾之后，隆中对定三分。" },
  { "id": "zg3", "t0": 5.8, "t1": 9.4, "text": "赤壁借东风，一炬破曹。" },
  { "id": "zg4", "t0": 9.4, "t1": 12.4, "text": "白帝受遗诏，鞠躬尽瘁。" },
  { "id": "zg5", "t0": 12.4, "t1": 15.2, "text": "五月渡泸，深入不毛，平定南中。" },
  { "id": "zg6", "t0": 15.2, "t1": 18.2, "text": "六出祁山，屡以弱攻强。" },
  { "id": "zg7", "t0": 18.2, "t1": 21.0, "text": "五丈原上，秋风萧瑟，将星欲坠。" },
  { "id": "zg8", "t0": 21.0, "t1": 24.8, "text": "星落之后，蜀人巷哭。" }
 ]
}
