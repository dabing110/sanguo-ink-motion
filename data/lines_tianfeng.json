  "lines": [
    {
      "id": "f1_jizhou",
      "t0": 0.0,
      "t1": 3.0,
      "text": "田丰，钜鹿人，天姿瑰杰。"
    },
    {
      "id": "f2_jibuke",
      "t0": 3.0,
      "t1": 5.8,
      "text": "劝绍袭许，绍以子病辞。"
    },
    {
      "id": "f3_kenjian",
      "t0": 5.8,
      "t1": 9.2,
      "text": "谏宜久持，绍怒械系之。"
    },
    {
      "id": "f4_yuzhong",
      "t0": 9.2,
      "t1": 12.2,
      "text": "囹圄之中，静待官渡。"
    },
    {
      "id": "f5_guandu",
      "t0": 12.2,
      "t1": 15.0,
      "text": "乌巢火起，绍军大溃。"
    },
    {
      "id": "f6_fuzhang",
      "t0": 15.0,
      "t1": 18.0,
      "text": "逢纪进谮，抚掌大笑。"
    },
    {
      "id": "f7_sizhi",
      "t0": 18.0,
      "t1": 21.0,
      "text": "绍惭其言，遂害田丰。"
    },
    {
      "id": "f8_qianqiu",
      "t0": 21.0,
      "t1": 24.8,
      "text": "不用吾言，果为所笑。"
    }
  ]
}