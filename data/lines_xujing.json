{
  "film": "xujing",
  "voice": "zh-CN-YunjianNeural",
  "style": "ink",
  "total": 24.8,
  "lines": [
    { "id": "xuj1", "t0": 0.0, "t1": 3.0, "text": "汝南许靖，与从弟劭俱知名，好核论人物。" },
    { "id": "xuj2", "t0": 3.0, "t1": 5.8, "text": "董卓乱起，周旋州郡，南走交州避祸。" },
    { "id": "xuj3", "t0": 5.8, "t1": 9.4, "text": "辗转入蜀，依刘璋，为蜀郡太守。" },
    { "id": "xuj4", "t0": 9.4, "t1": 12.4, "text": "先主围成都，靖窃欲逾城而出降。" },
    { "id": "xuj5", "t0": 12.4, "t1": 15.2, "text": "法正言于先主：靖名重天下，宜加敬。" },
    { "id": "xuj6", "t0": 15.2, "t1": 18.2, "text": "克成都，以为左将军长史，参机密。" },
    { "id": "xuj7", "t0": 18.2, "t1": 21.0, "text": "先主称帝，拜司徒，位望甚崇。" },
    { "id": "xuj8", "t0": 21.0, "t1": 24.8, "text": "章武二年卒，谥曰文休，麈尾长垂。" }
  ]
}
